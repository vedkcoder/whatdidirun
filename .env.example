# Copy to .env and adjust. Used by docker-compose.yml.

# Image tag to run (e.g. 0.1.0). Default: latest.
# WHATDIDIRUN_VERSION=latest

# Your host user/group (run `id -u` / `id -g`) so files in the data dir stay yours.
RECALL_UID=1000
RECALL_GID=1000

# Where the host shell hook writes (must match RECALL_DATA_DIR in your shell, default ~/.local/share/recall).
# RECALL_HOST_DATA_DIR=/home/you/.local/share/recall

# Port on 127.0.0.1 for the web UI.
RECALL_WEB_PORT=8765

# OpenAI-compatible server (LM Studio by default). host.docker.internal = the Docker host.
RECALL_LLM_BASE_URL=http://host.docker.internal:1234/v1
RECALL_LLM_API_KEY=lm-studio
RECALL_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# Empty = first non-embedding model the server reports.
RECALL_CHAT_MODEL=
RECALL_REASONING_EFFORT=none
RECALL_LLM_ENABLED=1
RECALL_DESCRIBE=1
