# Copy to .env and adjust. Used by docker-compose.yml.

# Image tag to run (e.g. 0.1.0). Default: latest.
# WHATDIDIRUN_VERSION=latest

# Your host user/group (run `id -u` / `id -g`) so files in the data dir stay yours.
RECALL_UID=1000
RECALL_GID=1000

# Where the host shell hook writes (must match RECALL_DATA_DIR in your shell, default ~/.local/share/recall).
# RECALL_HOST_DATA_DIR=/home/you/.local/share/recall

# Port on 127.0.0.1 for the web UI.
RECALL_WEB_PORT=8765

# Providers for chat and embeddings (see README > Providers): lmstudio, ollama, openai, anthropic,
# gemini, openrouter, groq, mistral, deepseek, xai, together, custom.
RECALL_CHAT_PROVIDER=lmstudio
RECALL_EMBED_PROVIDER=lmstudio
# Empty = first non-embedding model (local providers). Required for cloud providers.
RECALL_CHAT_MODEL=
# Empty = the provider's default embedding model.
RECALL_EMBED_MODEL=

# API keys for cloud providers (only the ones you use).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=

# LM Studio on the Docker host (host.docker.internal = the Docker host).
RECALL_LLM_BASE_URL=http://host.docker.internal:1234/v1
RECALL_LLM_API_KEY=lm-studio
# Ollama on the Docker host:
# RECALL_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Your own OpenAI-compatible server (provider id: custom):
# RECALL_CUSTOM_BASE_URL=
# RECALL_CUSTOM_API_KEY=
RECALL_REASONING_EFFORT=none
RECALL_LLM_ENABLED=1
RECALL_DESCRIBE=1
